<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Anime Explorer</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
    rel="stylesheet">
</head>

<body>
  <header class="p-4 text-bg-dark">
    <div class="container">
      <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">


        <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
          <li class="me-3" style="margin-top: -5px;">
            <label class="toggle-switch">
              <input type="checkbox" id="theme-toggle">
              <span class="slider round"></span>
            </label>
          </li>
          <li><a href="/favorites" class="nav-link px-2 text-white">MyAnimeList</a></li>
          <li><a href="/about" class="nav-link px-2 text-white">About</a></li>
        </ul>

        <form action="/submit" method="POST" class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
          <div class="input-group mb-10">
            <input type="text" name="fName" class="form-control" placeholder="Search an Anime"
              aria-label="Recipient's username" aria-describedby="button-addon2">
            <button class="btn btn-outline-secondary" type="submit" id="button-addon2">Search</button>
          </div>
        </form>

        <div class="text-end">
          <a href="./logout"><button type="button" class="btn btn-outline-light me-2">Log out</button></a>
          <a href="/register"><button type="button" class="btn btn-warning">Sign-up</button></a>
        </div>
      </div>
    </div>
  </header>

  <div class="container mt-5">
    <div id="center-hero" class="px-4 py-5 my-5 text-center">
      <svg width="200" height="200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
        <!-- Background Circle -->
        <circle cx="100" cy="100" r="95" stroke="#000000" stroke-width="5" fill="#F5F5F5" />

        <!-- Text for "Anime" -->
        <text x="50%" y="45%" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" fill="#FF4500">
          Anime
        </text>

        <!-- Text for "Finder" -->
        <text x="50%" y="65%" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" fill="#00008B">
          Explorer
        </text>

        <!-- Outer Circular Ring -->
        <circle cx="100" cy="100" r="90" stroke="#00008B" stroke-width="3" fill="none" />
      </svg>



      <h1 class="display-5 fw-bold text-body-emphasis">Welcome to Anime Explorer</h1>
      <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">Find information about your favorite anime, including genres, ratings, episodes, and more!
        </p>

      </div>
    </div>



    <!-- Display Search Results in Div Boxes -->
    <div class="container mt-5">
      <% if (locals.data) { %>
        <div class="row">
          <% data.data.forEach(function(anime) { %>
            <div class="col-md-4">
              <a style="text-decoration: none;" href="/anime/<%= anime.mal_id %>">
                <div class="result-box mt-5">
                  <img src="<%= anime.images.jpg.image_url %>" alt="<%= anime.title %>">
                  <h3>
                    <%= anime.title %>
                  </h3>
                </div>
              </a>
            </div>
            <% }); %>
        </div>
    </div>
    <!-- Pagination Controls -->
    <div class="pagination-bar">
      <!-- Previous Button -->
      <form action="/submit" method="POST" style="display:inline;">
        <input type="hidden" name="fName" value="<%= animeName %>">
        <input type="hidden" name="page" value="<%= currentPage - 1 %>">
        <button class="btn btn-secondary" type="submit" <%=currentPage==1 ? 'disabled' : '' %>>Previous</button>
      </form>

      <!-- Page Numbers -->
      <% pageNumbers.forEach(page=> { %>
        <form action="/submit" method="POST" style="display:inline;">
          <input type="hidden" name="fName" value="<%= animeName %>">
          <input type="hidden" name="page" value="<%= page %>">
          <button class="btn btn-outline-primary <%= page == currentPage ? 'active' : '' %>" type="submit">
            <%= page %>
          </button>
        </form>
        <% }); %>

          <!-- Next Button -->
          <form action="/submit" method="POST" style="display:inline;">
            <input type="hidden" name="fName" value="<%= animeName %>">
            <input type="hidden" name="page" value="<%= parseInt(currentPage) + 1 %>">
            <button class="btn btn-primary" type="submit" <%=currentPage>= totalPages ? 'disabled' : '' %>>Next</button>
          </form>
    </div>

    <p class="text-center">Page <%= currentPage %> of <%= totalPages %>
    </p>
    <script>
      document.getElementById('center-hero').style.display = 'none';
    </script>
    
      <% }else { %>
      <!-- Friendly placeholder when no results -->
      <div class="text-center my-5">
        <h3 class="text-muted">Search for your favorite anime above 👆</h3>
      </div>
      <% } %>
  </div>
  </div>
  <!-- Footer -->
  <footer class="footer-custom d-flex flex-wrap justify-content-center align-items-center py-4 mt-5">
    <span class="text-light">© 2024 Anime Explorer, All rights reserved</span>
  </footer>

  <script>
    const toggleSwitch = document.getElementById('theme-toggle');
    const body = document.body;

    // Load saved theme
    if (localStorage.getItem('theme') === 'dark') {
      body.classList.add('dark-mode');
      toggleSwitch.checked = true;
    }

    toggleSwitch.addEventListener('change', () => {
      if (toggleSwitch.checked) {
        body.classList.add('dark-mode');
        localStorage.setItem('theme', 'dark');
      } else {
        body.classList.remove('dark-mode');
        localStorage.setItem('theme', 'light');
      }
    });
  </script>


</body>

</html>