<%- include('partials/header') %>

  <div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 83vh;">
      <div class="col-md-10 col-lg-8 col-xl-6">
        <div class="card">
          <div class="card-body">
            <% if (typeof error !=="undefined" ) { %>
              <div class="alert alert-danger text-center mb-3" style="color: black;">
                <%= error %>
              </div>
              <% } %>

                <!-- Makes POST request to /register route -->
                <form action="/register" method="POST">
                  <div class="form-group mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                      <label for="email" class="mb-0">Email</label>
                      <a href="/">
                        <button class="btn btn-primary rounded-circle p-2 lh-1" type="button">
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                            xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round" />
                          </svg>

                        </button>
                      </a>
                    </div>
                    <input type="email" class="form-control mt-2" name="username" required>
                  </div>
                  <div class="form-group mb-3">
                    <label for="password">Password</label>
                    <input type="password" class="form-control" name="password" required>
                  </div>
                  <button type="submit" class="btn btn-dark w-100">Register</button>
                </form>

          </div>
        </div>
        <div class="text-center my-3">
          <span>or</span>
        </div>
        <div class="mt-3">
          <div class="card-body"><a href="/auth/google" role="button">
              <button class="btn btn-dark w-100">

                <i class="fab fa-google"></i>
                Sign Up with Google

              </button></a>
            <p class="text-center">
              Already have an account?
              <a href="/Login" class="fw-bold">Login</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <footer class="footer-custom d-flex flex-wrap justify-content-center align-items-center py-4 mt-5">
    <span class="text-light">© 2024 Anime Explorer, All rights reserved</span>
  </footer>



  <%- include('partials/footer') %>