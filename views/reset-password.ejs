<%- include('partials/header') %>

<div class="container">
  <div class="row justify-content-center align-items-center" style="min-height: 83vh;">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg rounded-3">
        <div class="card-body">
          <h3 class="text-center mb-4">Reset Password</h3>
          <p class="text-muted text-center">
            Enter your new password below.
          </p>

          <!-- POST to /reset-password/:token -->
          <form action="/reset-password/<%= token %>" method="POST">
            <div class="form-group mb-3">
              <label for="password">New Password</label>
              <input 
                type="password" 
                class="form-control" 
                name="password" 
                id="password" 
                placeholder="Enter new password"
                required>
            </div>
            <button type="submit" class="btn btn-dark w-100">Reset Password</button>
          </form>

          <div class="text-center mt-3">
            <a href="/login">Back to Login</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<footer class="footer-custom d-flex flex-wrap justify-content-center align-items-center py-4 mt-5">
  <span class="text-light">© 2024 Anime Explorer, All rights reserved</span>
</footer>

<%- include('partials/footer') %>
